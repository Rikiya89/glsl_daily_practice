// =====================================================================================================
//  SIPHONOPHORE ORACLE | TAB. I.  -- antique natural-history plate edition
//  Single GLSL TOP pixel shader for TouchDesigner. Output: 1080x1920 portrait.
//
//  LOOP CONTRACT
//    10 s seamless loop at any fps. Every time-dependent term has the form TAU*integer*phase,
//    so frame(10 s) == frame(0). Keep it that way: any new animation must use an INTEGER number
//    of cycles per loop (see harmonic()).
//
//  PIPELINE (per pixel)
//    1. initFrame()      phase + derived anatomy parameters from the CONTROL values
//    2. makeCamera()     slow orbiting camera; the body itself spins about its own axis
//    3. marchBody()      sphere-trace the SDF; every hit is a translucent layer (up to MAX_LAYERS)
//                        that tints a multiplicative watercolour wash and deposits ink / hatching / gilt
//    4. composite        aged paper * wash -> engraved ink + hatching -> gold leaf
//    5. callouts()       lettered leader lines, anchored to 3D anatomy via the same camera
//    6. typography()     plate title, caption, legend, frame rules (outline font rendered in-shader)
//
//  COORDINATE SPACES
//    body space  : y up, spine runs from TOP_Y (gas float) downward; the SDF lives here
//    world space : body space rotated by bodyToWorld (tilt + spin). world = bodyToWorld * body,
//                  body = world * bodyToWorld  (row-vector multiply == transpose == inverse)
//    plate space : 1080x1920 "paper pixels", origin top-left, y down. All 2D drawing is done here,
//                  so the layout is resolution independent; `ps` = size of one output pixel in plate units.
// =====================================================================================================

// ---------- 0. controls ------------------------------------------------------------------------------
// Set EXTERNAL_CONTROLS=1 ONLY after binding all CONTROL uniforms on the Vectors page (build_oracle.py does it).
// With 0, every CONTROL compiles to a constant (useful for preview / offline renders).
#define EXTERNAL_CONTROLS 0
out vec4 fragColor;
uniform float uTimeSeconds;
#if EXTERNAL_CONTROLS
#define CONTROL(name,value) uniform float name
#else
#define CONTROL(name,value) const float name=value
#endif
CONTROL(uBodyLength,1.0);       // .7..1.4  chamber-zone length
CONTROL(uChamberCount,16.);     // 12..20   rounded
CONTROL(uChamberRadius,.34);    // .2..0.44
CONTROL(uTentacleCount,24.);    // 8..40    rounded
CONTROL(uTentacleLength,.78);   // .3..1.1
CONTROL(uBreathing,1.);         // 0..2     chamber contraction amplitude
CONTROL(uWaveSpeed,2.);         // 1..4     rounded: waves per loop
CONTROL(uRotationSpeed,1.);     // 0..2     rounded: body turns per loop
CONTROL(uMotion,1.);            // 0..2     spine / tentacle sway
CONTROL(uAnimPhase,0.);         // 0..1     loop offset
CONTROL(uMembraneOpacity,1.);   // 0..2
CONTROL(uFresnel,1.);           // 0..2
CONTROL(uEmission,1.);          // 0..3
CONTROL(uGlow,1.);              // 0..3     in-shader halo
CONTROL(uShowAnnotations,1.);   // 0/1      lettered leader lines
CONTROL(uShowText,1.);          // 0/1      plate typography, rules and frame
CONTROL(uGraphicOpacity,1.);    // 0..1     ink strength overall
CONTROL(uInkStrength,1.);       // 0..1.5   contour / rib linework
CONTROL(uHatch,1.);             // 0..1.5   engraved hatching density
CONTROL(uWash,1.);              // 0..1.5   watercolour wash
CONTROL(uPaperAge,1.);          // 0..1.5   foxing, edge browning, gutter shadow
CONTROL(uCameraDistance,1.);
// Optional: #define DEBUG_T 0.25 to freeze the loop at a given phase.

// ---------- 1. constants -----------------------------------------------------------------------------
#define MAX_STEPS 150            // sphere-trace budget per pixel
#define MAX_LAYERS 6             // translucent surfaces composited per ray

const float PI=3.14159265359,TAU=6.28318530718,LOOP_SECONDS=10.;
const float TOP_Y=1.;            // body-space height of the top of the chamber chain (base of the gas float)
const float SHELL_T=.0055;       // half-thickness of every membrane shell

// Plate format (all 2D work happens in these units)
const vec2  PLATE=vec2(1080.,1920.);
const float PLATE_CX=540.;

// Material ids written to gMat by map()
const float MAT_NONE=0.;         // bounding proxy only (not a surface)
const float MAT_SHELL=1.;        // membrane: gas float, chambers, crown bulb
const float MAT_SPINE=2.;
const float MAT_NODE=3.;         // energy nodes at filament tips / chamber cores
const float MAT_FILAMENT=4.;     // radial filament trees
const float MAT_HELIX=5.;        // double-helix tendril
const float MAT_TENTACLE=6.;

// ---------- 2. per-frame state (written once in initFrame) -------------------------------------------
float phase;                     // 0..1 loop position
float waveCycles;                // integer travelling-wave cycles per loop (from uWaveSpeed)
float contractCycles;            // waveCycles+1: chamber contraction / upward pulse cycles per loop
float bodyTurns;                 // integer body revolutions per loop (from uRotationSpeed)
int   chamberCount,tentacleCount;
float chainLen;                  // length of the chamber chain
float chamberPitch;              // vertical spacing between chambers (chainLen/chamberCount)
float crownY;                    // height of the crown bulb / tentacle root
float tentLenMax;                // longest tentacle
float totalLen;                  // chain + tentacles: normalises the body coordinate w
float chamberRad;                // base chamber radius
float chainBoundR,tentBoundR;    // radii of the bounding cylinders used to skip work in map()
mat3  bodyToWorld;               // tilt * spin
vec3  lightKey;                  // key light direction, body space

// ---------- 2b. hit state (side outputs of map(), read by shading) -----------------------------------
float gMat;                      // material id of the closest surface
float gW;                        // body coordinate w at the sample (0 float .. 1 tentacle tips)
float gS;                        // material-local parameter (chamber s / tentacle s)
float gIdx;                      // chamber index (-1 float, -2 crown bulb) or tentacle sector id
vec3  gE;                        // sample position in the local frame of the hit shell
bool  gTrackHalo;                // when true, map() records the nearest inner-anatomy distance:
float gMinInnerD,gMinInnerW;     //   min distance seen along the ray, and the w where it occurred

// ---------- 3. math helpers --------------------------------------------------------------------------
mat3 rotY3(float a){float c=cos(a),s=sin(a);return mat3(c,0.,-s,0.,1.,0.,s,0.,c);}
mat3 rotZ3(float a){float c=cos(a),s=sin(a);return mat3(c,s,0.,-s,c,0.,0.,0.,1.);}
// Round to an integer and clamp: guarantees whole cycles per loop / whole element counts.
float harmonic(float x,float lo,float hi){return clamp(floor(x+.5),lo,hi);}
float h11(float x){return fract(sin(x*127.1+311.7)*43758.5453);}
// Bound-correct approximate ellipsoid SDF (iq).
float ellipsoid(vec3 p,vec3 r){float k0=length(p/r),k1=length(p/(r*r));return k0*(k0-1.)/max(k1,1e-6);}

// ---------- 4. anatomy (shared by the SDF, shading and the callout anchors) --------------------------
// Body coordinate: w = (TOP_Y-y)/totalLen  ->  0 at the float, 1 at the tentacle tips.

// Spine centre line (x,z) at w: travelling wave (integer cycles per loop) + a static asymmetric bend.
vec2 spineXZ(float w){
    float g=.25+.75*clamp(w,0.,1.);              // sway grows toward the tail
    float tr=TAU*(.9*w-waveCycles*phase);
    return vec2(.17*g*sin(tr+.4)*uMotion+.20*sin(2.7*w+.6),
                .12*g*cos(tr+1.5)*uMotion+.12*sin(2.1*w+2.3));
}
// Chamber size profile along the chain, s in 0..1: small at both ends, full in the middle.
float rprof(float s){s=clamp(s,0.,1.);return .42+.58*pow(sin(PI*pow(s,.78)),.8);}
// Rest radius of chamber j (profile + ±7% per-chamber jitter).
float chamberR(int j){float s=(float(j)+.5)/float(chamberCount);return chamberRad*rprof(s)*(1.+.14*(h11(float(j)*1.7+3.1)-.5));}
// Rhythmic contraction factor; the wave travels down the chain.
float contraction(float s){return 1.+.11*uBreathing*sin(TAU*contractCycles*phase-3.6*s);}
// Bioluminescent pulse at w: a strong train travelling down + a weaker one travelling up.
float pulseAt(float w){
    float a=pow(.5+.5*cos(TAU*(1.6*w-waveCycles*phase)),8.);
    float b=pow(.5+.5*cos(TAU*(2.4*w+contractCycles*phase+.3)),12.);
    return a+.45*b;
}
vec3 chamberCenter(int j){
    float y=TOP_Y-(float(j)+.5)*chamberPitch;
    vec2 c=spineXZ((TOP_Y-y)/totalLen);
    return vec3(c.x,y,c.y);
}
// Angular swirl of the whole tentacle bundle at height y (grows with distance below the crown).
float swirlAt(float y){float sg=clamp((crownY-y)/tentLenMax,0.,1.2);return .35*sin(TAU*(.5*sg-waveCycles*phase))*sg*uMotion;}
// Shared tentacle parameters for sector k at body height y.
//   s    : 0..1 position along the tentacle
//   rk   : distance from the spine axis (tentacles splay outward)
//   lat  : sideways sway, in arc-length units
//   rad  : tube radius (tapers toward the tip)
//   tipY : height of the sample's clamped centre-line point
//   W    : angular width of one sector
void tentParams(float k,float y,out float s,out float rk,out float lat,out float rad,out float tipY,out float W){
    float h=h11(k*3.7+1.3),h2=h11(k*5.1+.4),h3=h11(k*2.3+9.1);
    float Lk=tentLenMax*(.30+.70*h);             // per-tentacle length
    s=clamp((crownY-y)/Lk,0.,1.);
    float r0=.05+.04*h2;
    rk=r0+(.07+.34*h2)*pow(s,.85)+.022*sin(TAU*(1.7*s-waveCycles*phase)+TAU*h3)*s;
    W=TAU/float(tentacleCount);
    lat=-.30*rk*W*sin(TAU*(2.3*s-contractCycles*phase)+TAU*h3*1.7)*smoothstep(0.,.3,s)*uMotion;
    rad=mix(.0075,.0032,s);
    tipY=crownY-s*Lk;
}
// Centre line of tentacle k at fraction s, body space (used as a callout anchor).
vec3 tentPos(int k,float s){
    float kk=float(k);float h=h11(kk*3.7+1.3);float Lk=tentLenMax*(.30+.70*h);
    float y=crownY-s*Lk,ss,rk,lat,rad,tipY,W;
    tentParams(kk,y,ss,rk,lat,rad,tipY,W);
    float a=TAU*kk/float(tentacleCount)+swirlAt(y)+lat/max(rk,1e-3);
    vec2 sp=spineXZ((TOP_Y-y)/totalLen);
    return vec3(sp.x+rk*cos(a),y,sp.y+rk*sin(a));
}

