    float cs=contraction(s);
    R=chamberR(j)*cs;ry=1.25*chamberPitch*(2.-cs);     // volume-ish: narrower -> taller
    float hn=clamp(e.y/ry,-1.,1.);
    float bell=1.-.28*hn;
    float E=ellipsoid(vec3(e.x/bell,e.y,e.z/bell),vec3(R,ry,R));
    return abs(E)-SHELL_T;
}
// Radial filament tree in the frame of chamber j: 3 spokes (golden-angle twist per chamber)
// that fork at 45% of their length and end in energy nodes.
void filamentTree(vec3 e,int j,float R,out float dFil,out float dNode){
    float rho=.62*R,fr=.45*rho;                  // spoke length, fork radius
    float r=length(e.xz);
    float a=atan(e.z,e.x)-2.39996*float(j);      // golden angle twist
    a=mod(a+PI/3.,TAU/3.)-PI/3.;                 // fold into one of 3 sectors
    float lat=r*a,q=r/max(rho,1e-4);
    float h=e.y+.3*chamberPitch*q*q;             // spokes droop parabolically
    float th=.0036;
    float rr=clamp(r,0.,fr);
    float dm=length(vec3(r-rr,lat,h))-th;                    // main stem up to the fork
    float rr2=clamp(r,fr,rho);
    float lt=abs(lat)-.38*(rr2-fr);                          // two mirrored branches after the fork
    float dk=length(vec3(r-rr2,lt,h))-th*.8;
    float pj=pulseAt((TOP_Y-(float(j)+.5)*chamberPitch)/totalLen);
    dNode=length(vec3(r-rho,abs(lat)-.38*(rho-fr),h))-.0095*(.8+.5*pj);   // nodes swell with the pulse
    dFil=min(dm,dk);
}
vec2 map(vec3 p){
    float w=(TOP_Y-p.y)/totalLen;
    vec2 qs=p.xz-spineXZ(w);                     // horizontal offset from the spine
    float dAx=length(qs);                        // distance to the spine axis
    float d,m,dB=1e3;                            // dB: distance to the bounding proxies
    gW=clamp(w,0.,1.);gS=0.;

    // --- spine + stem (clipped between the float and the crown bulb) ---
    float pw=pulseAt(clamp(w,0.,1.));
    float ds=max(dAx-.011*(1.+.7*pw),max(p.y-(TOP_Y+.22),(crownY-.16)-p.y));
    d=ds;m=MAT_SPINE;
    float dInner=ds;                             // inner anatomy distance (drives the halo)

    // --- gas float (pneumatophore): membrane shell ---
    {
        float yH=TOP_Y+.19;vec2 c=spineXZ((TOP_Y-yH)/totalLen);
        vec3 e=p-vec3(c.x,yH,c.y);
        float E=ellipsoid(e,vec3(.105,.15,.105)*(1.+.035*uBreathing*sin(TAU*contractCycles*phase)));
        float dh=abs(E)-SHELL_T;
        if(dh<d){d=dh;m=MAT_SHELL;gE=e;gIdx=-1.;gS=0.;}
    }

    // --- chamber chain: shells, filament trees, nodes, double helix ---
    float yTopC=TOP_Y+.12,yBotC=TOP_Y-chainLen-.12;
    if(p.y<yTopC&&p.y>yBotC){
        if(dAx<chainBoundR){
            float f=(TOP_Y-p.y)/chamberPitch-.5;
            int j0=int(clamp(floor(f+.5),0.,float(chamberCount-1)));   // nearest chamber
            float dmem=1e3,dfil=1e3,dnode=1e3;vec3 eM=vec3(0.);float idM=0.,sM=0.;
            for(int k=-1;k<=1;k++){              // neighbours overlap: test j0-1..j0+1
                int j=j0+k;if(j<0||j>=chamberCount)continue;
                vec3 e;float R,ry;
                float dd=chamberShell(p,j,e,R,ry);
                if(dd<dmem){dmem=dd;eM=e;idM=float(j);sM=(float(j)+.5)/float(chamberCount);}
                if(abs(e.y)<.8*chamberPitch){
                    float a,b;filamentTree(e,j,R,a,b);
                    dfil=min(dfil,a);
                    if(k==0)dnode=length(e)-.02*(.9+.6*pulseAt((TOP_Y-(float(j)+.5)*chamberPitch)/totalLen));  // chamber core
                    dnode=min(dnode,b);
                }
            }
            // double helix tendril wound through the chain
            float rh=.45*chamberRad*rprof(clamp((TOP_Y-p.y)/chainLen,0.,1.));   // helix radius follows the chambers
            float P=1.4*chamberPitch,ang=atan(qs.y,qs.x);                      // pitch, angle around the spine
            float hh=p.y-ang*P/TAU;
            float cf=P/sqrt(P*P+TAU*TAU*rh*rh);                                // slope correction -> true distance
            float h1=mod(hh+.5*P,P)-.5*P,h2=mod(hh,P)-.5*P;                    // two strands, half a pitch apart
            float rr=dAx-rh;
            float dhel=min(length(vec2(rr,h1*cf)),length(vec2(rr,h2*cf)))-.0028;
            dhel=max(dhel,max(p.y-TOP_Y,(TOP_Y-chainLen)-p.y));
            if(dmem<d){d=dmem;m=MAT_SHELL;gE=eM;gIdx=idM;gS=sM;}
            if(dfil<d){d=dfil;m=MAT_FILAMENT;gS=(idM+.5)/float(chamberCount);}
            if(dnode<d){d=dnode;m=MAT_NODE;}
            if(dhel<d){d=dhel;m=MAT_HELIX;}
            dInner=min(dInner,min(min(dfil,dnode),dhel));
        }else dB=min(dB,dAx-chainBoundR);
    }else dB=min(dB,zoneBound(p,dAx,chainBoundR,yTopC,yBotC));
    if(gTrackHalo&&dInner<gMinInnerD){gMinInnerD=dInner;gMinInnerW=gW;}

    // --- crown bulb ---
    {
        float yB=crownY-.035;vec2 c=spineXZ((TOP_Y-yB)/totalLen);
        vec3 e=p-vec3(c.x,yB,c.y);
        float dBulb=abs(ellipsoid(e,vec3(.085,.055,.085)))-SHELL_T;
        if(dBulb<d){d=dBulb;m=MAT_SHELL;gE=e;gIdx=-2.;gS=1.;}
    }

    // --- tentacle bundle: polar repetition into tentacleCount sectors ---
    float yTopT=crownY+.04,yBotT=crownY-tentLenMax-.05;
    if(p.y<yTopT&&p.y>yBotT){
        if(dAx<tentBoundR){
            float a=atan(qs.y,qs.x)-swirlAt(p.y);
            float W=TAU/float(tentacleCount);
            float id0=floor(a/W+.5);
            float dt=1e3,sB=0.,idB=0.;
            for(int k=-1;k<=1;k++){              // neighbour sectors too: the fold alone is discontinuous
                float id=id0+float(k),aa=a-id*W;
                float kk=mod(id,float(tentacleCount));
                float s,rk,lat,rad,tipY,Wt;
                tentParams(kk,p.y,s,rk,lat,rad,tipY,Wt);
                float dxz=length(vec2(dAx-rk,dAx*aa-lat));
                float dk=length(vec2(dxz,p.y-tipY))-rad;
                dk=min(dk,length(vec2(dxz,p.y-tipY))-.0065*step(.999,s));   // bead at the tip
                if(dk<dt){dt=dk;sB=s;idB=kk;}
            }
            dt*=.75;                             // curved centre line: stay conservative
            if(dt<d){d=dt;m=MAT_TENTACLE;gS=sB;gIdx=idB;gW=clamp(w,0.,1.2);}
        }else dB=min(dB,dAx-tentBoundR);
    }else dB=min(dB,zoneBound(p,dAx,tentBoundR,yTopT,yBotT));

    if(dB<d){d=dB;m=MAT_NONE;}
    gMat=m;
    return vec2(d,m);
}
// Tetrahedral normal. Halo tracking is suspended so the 4 taps don't pollute it.
vec3 normalAt(vec3 p,float e){
    bool tr=gTrackHalo;gTrackHalo=false;
    vec2 k=vec2(1.,-1.);
    vec3 n=normalize(k.xyy*map(p+k.xyy*e).x+k.yyx*map(p+k.yyx*e).x+k.yxy*map(p+k.yxy*e).x+k.xxx*map(p+k.xxx*e).x);
    gTrackHalo=tr;return n;
}

// ---------- 7. plate palette, paper, drawing primitives ----------------------------------------------
// Display-referred pigments; washes multiply over the paper.
const vec3 PAPER=vec3(.925,.875,.760),INK=vec3(.105,.080,.060);
const vec3 TEAL=vec3(.50,.82,.86),BLUE=vec3(.40,.62,.90),VERM=vec3(.80,.27,.19),MADDER=vec3(.70,.20,.28);
const vec3 OCHRE=vec3(.88,.70,.36),ROSE=vec3(.95,.58,.60),GOLD=vec3(.82,.62,.20);

float vh(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
float vn(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(vh(i),vh(i+vec2(1,0)),f.x),mix(vh(i+vec2(0,1)),vh(i+vec2(1,1)),f.x),f.y);}
float fbm(vec2 p){return .5*vn(p)+.25*vn(p*2.03+7.1)+.125*vn(p*4.1+3.7)+.0625*vn(p*8.3+1.3);}

// Aged laid paper at plate position pr.
vec3 paperAt(vec2 pr){
    vec2 q=pr/PLATE;
    float age=clamp(uPaperAge,0.,1.5);
    vec3 c=PAPER*(.92+.14*fbm(q*vec2(5.,8.)));
    c*=1.-.05*vn(vec2(q.x*320.,q.y*38.));                // laid-paper fibres
    c*=1.-.035*vn(vec2(q.x*40.,q.y*300.));
    vec2 g=q*vec2(11.,19.),id=floor(g),f=fract(g)-.5;    // foxing: sparse brown spots on a jittered grid
    vec2 off=(vec2(vh(id+1.3),vh(id+8.1))-.5)*.5;
    float spot=step(.90,vh(id+3.7))*smoothstep(.20,0.,length(f-off))*(.5+.5*vn(g*9.));
    c=mix(c,vec3(.55,.36,.18),spot*.35*age);
    float edge=1.-smoothstep(0.,.16,min(min(q.x,1.-q.x),min(q.y,1.-q.y)*.56));
    c=mix(c,c*vec3(.74,.60,.44),edge*.6*age);            // browned edges
    c*=1.-.22*exp(-q.x*14.)*age;                         // binding shadow (gutter on the left)
    c*=1.+(vh(pr)-.5)*.03;                               // per-pixel grain
    return c;
}

// Engraved hatching. d (0..1) = darkness: first set of 45° lines thickens with d,
// cross-hatching (-45°) joins above d = .5.
float hatchSet(float u,float w,float aa){float t=min(fract(u),1.-fract(u));return smoothstep(w*.5+aa,w*.5-aa,t);}
float hatch(vec2 p,float d,float ps){
    float pitch=5.2,aa=.9*ps/pitch;
    float a=hatchSet((p.x+p.y)/(pitch*1.4142),clamp(d,0.,1.)*.75,aa);
    float b=hatchSet((p.x-p.y)/(pitch*1.4142),clamp((d-.5)*2.,0.,1.)*.75,aa)*step(.5,d);
    return max(a,b);
}
// 2D coverage primitives (anti-aliased over one output pixel, ps)
float segD(vec2 p,vec2 a,vec2 b){vec2 pa=p-a,ba=b-a;float h=clamp(dot(pa,ba)/max(dot(ba,ba),1e-6),0.,1.);return length(pa-ba*h);}
float cov(float d,float w,float ps){return clamp(.5+(w*.5-d)/ps,0.,1.);}          // stroke of width w around d=0
float discCov(float d,float r,float ps){return clamp(.5-(d-r)/ps,0.,1.);}         // filled shape of radius r
float rectRule(vec2 p,vec2 lo,vec2 hi,float lw,float ps){
    vec2 d=abs(p-.5*(lo+hi))-.5*(hi-lo);return cov(abs(max(d.x,d.y)),lw,ps);
}

// ---------- 8. camera --------------------------------------------------------------------------------
struct Camera{vec3 ro,fw,rt,up;float tanH,aspect;};
// Small periodic orbit (±3° azimuth, 9±1.5° elevation) so the plate "breathes" without drifting.
Camera makeCamera(float aspect){
    float az=radians(3.*sin(TAU*phase)),elv=radians(9.+1.5*cos(TAU*phase));
    vec3 eyeDir=vec3(sin(az)*cos(elv),sin(elv),cos(az)*cos(elv));
    Camera c;
    c.fw=-eyeDir;c.rt=normalize(cross(c.fw,vec3(0.,1.,0.)));c.up=cross(c.rt,c.fw);
    c.tanH=tan(radians(26.)*.5);                 // 26° vertical FOV
    c.ro=eyeDir*11.*max(uCameraDistance,.5);
    c.aspect=aspect;
    return c;
}
// World position -> plate pixel (inverse of the primary-ray construction in main()).
vec2 projectW(vec3 Pw,Camera c){
    vec3 rel=Pw-c.ro;float z=dot(rel,c.fw);
    vec2 uvp=vec2(dot(rel,c.rt),dot(rel,c.up))/(z*c.tanH);
    vec2 vuv=uvp/(2.*vec2(c.aspect,1.))+.5;
    return vec2(vuv.x*PLATE.x,(1.-vuv.y)*PLATE.y);
}

// ---------- 9. typography ----------------------------------------------------------------------------
float textWidth(int n,float tr){float w=0.;for(int i=0;i<n;i++)w+=GW[gB[i]]+tr;return w-tr;}
// Draw the first n glyphs of gB with baseline origin org, scale s, tracking tr.
// The glyph under the pixel is found from the real advance widths, then filled from its flattened
// outline: signed distance = nearest segment distance, sign from the non-zero winding number.
float drawText(vec2 p,vec2 org,float s,float tr,int n,int align,float ps){
    float w=textWidth(n,tr)*s;
    float x0=org.x-(align==ALIGN_CENTER?.5*w:(align==ALIGN_RIGHT?w:0.));
    vec2 q=vec2(p.x-x0,org.y-p.y);
    if(q.x<-s||q.x>w+s||q.y<-2.4*s||q.y>7.2*s)return 0.;    // outside the line box
    float xu=q.x/s,acc=0.;int cd=0;float lx=0.;bool found=false;
    for(int i=0;i<n;i++){
        int c=gB[i];float adv=GW[c]+tr;
        if(xu<acc+adv){cd=c;lx=xu-acc;found=true;break;}
        acc+=adv;
    }
    if(!found)return 0.;
    vec2 uv=vec2(lx,q.y/s);
    float d2=1e9;int wn=0;
    for(int k=GI[cd];k<GI[cd+1]-1;k++){
        int g0=PT[k];
        if(((g0>>20)&1)==1)continue;                         // last point of a contour: no segment to the next
        int g1=PT[k+1];
        vec2 a=vec2(float(g0&1023),float((g0>>10)&1023))/32.-vec2(2.,3.);
        vec2 b=vec2(float(g1&1023),float((g1>>10)&1023))/32.-vec2(2.,3.);
        vec2 e=b-a,r=uv-a;
        float h=clamp(dot(r,e)/max(dot(e,e),1e-8),0.,1.);vec2 dv=r-e*h;d2=min(d2,dot(dv,dv));
        float cr=e.x*r.y-e.y*r.x;
        if(a.y<=uv.y){if(b.y>uv.y&&cr>0.)wn++;}else{if(b.y<=uv.y&&cr<0.)wn--;}
    }
    float sd=sqrt(d2)*(wn!=0?-1.:1.);
    return clamp(.5-(sd*s+(vn(p*.8)-.5)*.4)/ps,0.,1.);       // slight ink bleed
}
// One text line at baseline cy. The row test skips string building and glyph lookup for pixels
// outside the line box (identical window to the early-out in drawText).
#define TEXT_LINE(cy,sz,build,tr,x,al) if(abs(pr.y-((cy)-2.4*(sz)))<4.8*(sz)){int n=build;tcov=max(tcov,drawText(pr,vec2(x,cy),sz,tr,n,al,ps));}
float typography(vec2 pr,float ps){
    float tcov=0.;
    // header row
    TEXT_LINE(120.,3.6,s_TAB(),.1,PLATE_CX,ALIGN_CENTER)
    TEXT_LINE(120.,2.9,s_SPEC(),.08,110.,ALIGN_LEFT)
    TEXT_LINE(120.,2.9,s_PhaseReadout(),.08,970.,ALIGN_RIGHT)
    // title + subtitle
    TEXT_LINE(236.,10.4,s_T1(),.22,PLATE_CX,ALIGN_CENTER)
    TEXT_LINE(313.,10.4,s_T2(),.22,PLATE_CX,ALIGN_CENTER)
    TEXT_LINE(394.,3.2,s_SUB(),.06,PLATE_CX,ALIGN_CENTER)
    // caption, legend (live counts), disclaimer
    TEXT_LINE(1522.,3.7,s_CAP(),.05,PLATE_CX,ALIGN_CENTER)
    TEXT_LINE(1566.,3.1,s_Legend1(),.05,PLATE_CX,ALIGN_CENTER)
    TEXT_LINE(1592.,3.1,s_Legend2(),.05,PLATE_CX,ALIGN_CENTER)
    TEXT_LINE(1640.,2.9,s_DISC(),.05,PLATE_CX,ALIGN_CENTER)
    // double frame, header rule, ornamental rule + diamond under the title
    tcov=max(tcov,rectRule(pr,vec2(40.),vec2(1040.,1880.),2.4,ps));
    tcov=max(tcov,rectRule(pr,vec2(52.),vec2(1028.,1868.),1.,ps));
    tcov=max(tcov,cov(segD(pr,vec2(110.,142.),vec2(970.,142.)),1.2,ps));
    tcov=max(tcov,cov(segD(pr,vec2(300.,352.),vec2(500.,352.)),1.2,ps));
    tcov=max(tcov,cov(segD(pr,vec2(580.,352.),vec2(780.,352.)),1.2,ps));
    tcov=max(tcov,discCov(abs(pr.x-PLATE_CX)+abs(pr.y-352.),8.,ps));
    return tcov;
}

// ---------- 10. material shading ---------------------------------------------------------------------
// What one translucent surface contributes to the plate.
struct PlateSample{
    vec3  pig;     // pigment colour of the wash
    float pa;      // wash strength (0 = no tint)
    float ink;     // contour / rib ink coverage
    float hatch;   // hatching darkness request
    float gilt;    // gold-leaf highlight
    float alpha;   // geometric opacity (how much it hides what is behind)
    float thick;   // distance to step through before searching for the next layer
};
// Uses the hit state left by map(): gMat, gS, gE, gIdx.
PlateSample shadePlate(vec3 p,vec3 n,vec3 rd,float eps){
    PlateSample o;
    float m=gMat,s=gS;
    float w=clamp((TOP_Y-p.y)/totalLen,0.,1.2);
    float pl=pulseAt(min(w,1.));
    float ndv=clamp(dot(n,-rd),0.,1.);
    float F=pow(1.-ndv,3.2);                     // fresnel: silhouettes read as ink outlines
    float dif=.5+.5*dot(n,lightKey);             // half-lambert, only drives hatching
    o.pig=vec3(1.);o.pa=0.;o.ink=0.;o.hatch=0.;o.gilt=0.;
    if(m<MAT_SHELL+.5){                          // membrane
        vec3 e=gE;float a=atan(e.z,e.x);
        float ribs=pow(abs(cos(a*4.+gIdx*.7)),20.);           // 8 meridian ribs
        float rings=pow(abs(cos(e.y/chamberPitch*PI*3.)),30.); // latitude rings
        vec3 tint=mix(BLUE,TEAL,.5+.5*sin(gIdx*.9));
        o.pig=mix(tint,ROSE,smoothstep(.45,1.1,w));
        o.pa=clamp((.10+.34*F*uFresnel+.06*ribs)*uWash*uMembraneOpacity,0.,.6);
        o.ink=clamp(pow(F,3.)*1.3*uFresnel+ribs*.32+rings*.16,0.,1.)*uInkStrength;
        o.hatch=clamp((1.-dif)*1.2-.48+F*.25,0.,1.)*.6*uHatch;
        o.gilt=pl*ribs*.5;
        o.alpha=clamp((.06+.46*F*uFresnel+.10*ribs+.05*rings)*uMembraneOpacity,0.,.82);
        o.thick=2.3*SHELL_T+2.*eps;
    }else if(m<MAT_SPINE+.5){    o.pig=VERM;  o.pa=.9; o.ink=.85*uInkStrength;o.gilt=pl*.9; o.alpha=.9; o.thick=.03;
    }else if(m<MAT_NODE+.5){     o.pig=MADDER;o.pa=.9; o.ink=.7*uInkStrength; o.gilt=pl*.8; o.alpha=.95;o.thick=.04;
    }else if(m<MAT_FILAMENT+.5){ o.pig=OCHRE; o.pa=.35;o.ink=.6*uInkStrength; o.gilt=pl*.25;o.alpha=.55;o.thick=.012;
    }else if(m<MAT_HELIX+.5){    o.pig=OCHRE; o.pa=.4; o.ink=.45*uInkStrength;               o.alpha=.42;o.thick=.01;
    }else{                                       // tentacle: rose, darkening to madder at the tip
        float tip=smoothstep(.92,1.,s);
        o.pig=mix(ROSE,MADDER,tip);o.pa=.40+.5*tip;o.ink=(.5+.4*tip)*uInkStrength;o.gilt=tip*pl*.5;o.alpha=.55;o.thick=.012;
    }
    return o;
}

// ---------- 11. frame setup + ray march --------------------------------------------------------------
void initFrame(){
    float seconds=uTimeSeconds;
    if(isnan(seconds)||isinf(seconds))seconds=0.;
    phase=fract(seconds/LOOP_SECONDS+uAnimPhase);
#ifdef DEBUG_T
    phase=DEBUG_T;
#endif
    waveCycles=harmonic(uWaveSpeed,1.,4.);contractCycles=waveCycles+1.;bodyTurns=harmonic(uRotationSpeed,0.,2.);
    chamberCount=int(harmonic(uChamberCount,12.,20.));tentacleCount=int(harmonic(uTentacleCount,6.,40.));
    chainLen=1.5*clamp(uBodyLength,.6,1.5);chamberPitch=chainLen/float(chamberCount);
    crownY=TOP_Y-chainLen-.03;tentLenMax=clamp(uTentacleLength,.2,1.2);totalLen=chainLen+.03+tentLenMax;
    chamberRad=clamp(uChamberRadius,.15,.5);chainBoundR=chamberRad*1.45+.07;tentBoundR=.62;
    bodyToWorld=rotZ3(radians(-9.))*rotY3(TAU*phase*bodyTurns);   // fixed 9° tilt, integer turns per loop
    lightKey=normalize(vec3(-.55,.65,.55))*bodyToWorld;           // world-fixed light, expressed in body space
}
// Ray interval [x,y] inside the body's bounding cylinder (radius 1.3, capped above the float and
// below the longest tentacle). Returns x>y on a miss.
vec2 boundsInterval(vec3 ro,vec3 rd){
    float top=TOP_Y+.9,bot=crownY-tentLenMax-.5,RC=1.3;
    float a=dot(rd.xz,rd.xz),b=dot(ro.xz,rd.xz),c=dot(ro.xz,ro.xz)-RC*RC;
    float disc=b*b-a*c;
    vec2 t=vec2(1e3,-1e3);
    if(disc>0.&&a>1e-8){
        float sq=sqrt(disc);float t0=(-b-sq)/a,t1=(-b+sq)/a;
        float ty0=(top-ro.y)/rd.y,ty1=(bot-ro.y)/rd.y;
        t=vec2(max(t0,min(ty0,ty1)),min(t1,max(ty0,ty1)));
    }
    return t;
}
// Sphere-trace through the body (body space). Each hit is treated as a thin translucent layer:
// we accumulate its wash, ink, hatching and gilt, step through it, and keep going until
// MAX_LAYERS or the remaining transmittance T is negligible.
//   pigment : multiplicative wash colour     inkC : contour ink coverage
//   hatchD  : hatching darkness              gilt : gold-leaf amount
// Also fills gMinInnerD / gMinInnerW for the halo.
void marchBody(vec3 ro,vec3 rd,out vec3 pigment,out float inkC,out float hatchD,out float gilt){
    pigment=vec3(1.);inkC=0.;hatchD=0.;gilt=0.;
    float T=1.;                                  // transmittance of the layers in front
    gMinInnerD=1e3;gMinInnerW=0.;gTrackHalo=true;
    vec2 tr=boundsInterval(ro,rd);
    if(tr.y>tr.x){
        float t=max(tr.x,0.);int layers=0;
        for(int i=0;i<MAX_STEPS;i++){
            vec3 pos=ro+rd*t;
            float eps=max(.0004,t*.00012);
            float dist=map(pos).x;
            if(dist<eps&&gMat>MAT_NONE+.5){
                vec3 n=normalAt(pos,max(.0008,t*.0002));
                if(dot(n,rd)>0.)n=-n;            // back faces of shells: shade as front faces
                gTrackHalo=false;map(pos);gTrackHalo=true;   // normalAt's taps overwrote the hit state: restore it
                float matId=gMat;
                PlateSample sm=shadePlate(pos,n,rd,eps);
                pigment=max(pigment*mix(vec3(1.),sm.pig,sm.pa),vec3(.50,.52,.55));   // floor keeps stacked washes from going muddy
                inkC=max(inkC,sm.ink*(.35+.65*T));                                  // ink behind other layers fades
                hatchD=min(1.,hatchD+sm.hatch*T);
                gilt=max(gilt,sm.gilt*(.5+.5*T));
                T*=1.-sm.alpha*(matId<MAT_NODE+.5?1.:.25);  // shells / spine / nodes occlude; thin parts barely do
                t+=sm.thick;layers++;
                if(layers>=MAX_LAYERS||T<.02)break;
            }else t+=max(max(dist*.8,eps*.5),gMat<MAT_NONE+.5?.004:0.);   // min step when only a proxy is near
            if(t>tr.y)break;
        }
    }
    gTrackHalo=false;
}

// ---------- 12. callouts -----------------------------------------------------------------------------
// Label positions (plate pixels). Labels at x>PLATE_CX sit on the right, the leader ends 22 px inside.
const vec2 CALLOUT_POS[4]=vec2[4](vec2(962.,500.),vec2(118.,700.),vec2(962.,930.),vec2(118.,1290.));
// A: gas float (right edge)   B: chamber 3 (left edge)   C: spine at mid-chain   D: tentacle 0 at 78%
float callouts(vec2 pr,float ps,Camera cam){
    vec3 anchor[4];
    vec2 sH=spineXZ((TOP_Y-(TOP_Y+.19))/totalLen);
    anchor[0]=bodyToWorld*vec3(sH.x,TOP_Y+.19,sH.y)+cam.rt*.105;
    anchor[1]=bodyToWorld*chamberCenter(3)-cam.rt*chamberR(3)*contraction(3.5/float(chamberCount));
    vec2 sm=spineXZ(.5*chainLen/totalLen);
    anchor[2]=bodyToWorld*vec3(sm.x,TOP_Y-.5*chainLen,sm.y);
    anchor[3]=bodyToWorld*tentPos(0,.78);
    float ink=0.;
    for(int i=0;i<4;i++){
        vec2 A=projectW(anchor[i],cam);
        vec2 S=CALLOUT_POS[i];
        vec2 E=S+vec2(S.x>PLATE_CX?-22.:22.,0.);
        ink=max(ink,cov(segD(pr,A,E),1.1,ps));               // leader line
        ink=max(ink,discCov(length(pr-A),2.6,ps));           // dot on the anatomy
        if(abs(pr.y-S.y)<40.){int n=s_Letter(i);ink=max(ink,drawText(pr,vec2(S.x,S.y+12.),4.1,0.,n,ALIGN_CENTER,ps));}
    }
    return ink;
}

// ---------- 13. main ---------------------------------------------------------------------------------
void main(){
    initFrame();
    vec2 res=uTDOutputInfo.res.zw;
    float aspect=res.x/max(res.y,1.);
    float ps=PLATE.y/max(res.y,1.);              // one output pixel, in plate units
    vec2 pr=vec2(vUV.x*PLATE.x,(1.-vUV.y)*PLATE.y);

    // primary ray (world) -> body space
    Camera cam=makeCamera(aspect);
    vec2 uv=(vUV.st-.5)*vec2(aspect,1.)*2.;
    vec3 rd=normalize(cam.fw+(uv.x*cam.rt+uv.y*cam.up)*cam.tanH);
    vec3 rob=cam.ro*bodyToWorld,rdb=rd*bodyToWorld;

    vec3 pigment;float inkC,hatchD,gilt;
    marchBody(rob,rdb,pigment,inkC,hatchD,gilt);

    // watery teal bleed around the inner anatomy, brighter where the pulse passes
    float mi=max(gMinInnerD,0.);
    float halo=(.11*exp(-26.*mi)+.04*exp(-7.*mi))*uGlow*(.30+1.2*pulseAt(gMinInnerW));
    pigment*=mix(vec3(1.),TEAL,clamp(halo*2.2,0.,.4)*uWash);

    // paper * wash (with pigment granulation)
    vec3 col=paperAt(pr);
    col*=pow(pigment,vec3(.85+.3*fbm(pr/7.)));

    // ink + hatching with a 12 fps hand-drawn "boil" (120 jitter states per loop -> still periodic)
    float fj=floor(phase*120.);
    vec2 pj=pr+(vec2(vh(vec2(fj,1.)),vh(vec2(fj,2.)))-.5)*1.4;
    float lines=max(inkC,hatch(pj,hatchD,ps)*smoothstep(.03,.12,hatchD)*.7)*clamp(uGraphicOpacity,0.,1.);
    col=mix(col,INK,lines*.92);

    // gold leaf on pulses
    col=mix(col,GOLD*(.85+.3*vn(pr*.12)),clamp(gilt*uEmission,0.,1.)*.85);

    // plate graphics: callouts + typography, printed in ink on top
    float ink2=0.;
    if(uShowAnnotations>.5)ink2=max(ink2,callouts(pr,ps,cam));
    if(uShowText>.5)ink2=max(ink2,typography(pr,ps));
    col=mix(col,INK*(.95+.1*vh(pr+3.)),ink2*.93*clamp(uGraphicOpacity,0.,1.));

    fragColor=TDOutputSwizzle(vec4(col,1.));
}
