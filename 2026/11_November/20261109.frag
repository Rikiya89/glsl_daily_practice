// Append the decimal digits of v (zero-padded to minDigits) at gB[n]; returns the new length.
int appendInt(int n,int v,int minDigits){
    int digits=1;for(int t=v/10;t>0;t/=10)digits++;
    digits=max(digits,minDigits);
    for(int i=digits-1;i>=0;i--){int dv=v;for(int k=0;k<i;k++)dv/=10;gB[n++]=DIG0+dv%10;}
    return n;
}
